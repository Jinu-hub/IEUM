{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ieum-flue",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Prompt DB release to read; local .dev.vars overrides it with "dev".
  "vars": { "PROMPT_ENVIRONMENT": "production" },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["FlueTestAgentAgent"] },
    { "tag": "v2", "new_sqlite_classes": ["FlueDailyCoreAgent"] },
    { "tag": "v3", "new_sqlite_classes": ["FlueCoreInterpreterAgent"] },
    { "tag": "v4", "new_sqlite_classes": ["FlueCoreStructurerAgent"] },
    { "tag": "v5", "deleted_classes": ["FlueDailyCoreAgent"] },
    { "tag": "v6", "new_sqlite_classes": ["FlueDailyReportWriterAgent"] },
    { "tag": "v7", "new_sqlite_classes": ["FlueDailyReportFinalizerAgent"] },
    { "tag": "v8", "new_sqlite_classes": ["FlueSignalExtractorAgent"] }
  ]
}
